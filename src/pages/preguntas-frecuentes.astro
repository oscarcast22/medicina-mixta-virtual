---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../sections/Nav.astro";
import Footer from "../sections/Footer.astro";
import HeroPreguntasFrecuentes from "../sections/HeroPreguntasFrecuentes.astro";
import QAs from '../utils/QAs';
import WhatsAppWidget from "../components/WhatsAppWidget.astro";
import { faqSchema, type FaqItem } from "../utils/seo";

const faqItems = QAs as FaqItem[];
---

<BaseLayout
    title="Preguntas Frecuentes | Medicina Mixta-Virtual UAD"
    description="Resuelve tus dudas sobre horarios, clases, prácticas clínicas, requisitos tecnológicos, admisión, titulación y validez de Medicina Mixta-Virtual UAD."
    breadcrumbs={[
        { name: "Inicio", path: "/" },
        { name: "Preguntas Frecuentes", path: "/preguntas-frecuentes/" },
    ]}
    schema={faqSchema(faqItems)}
>
    <Nav LicenciaturaTitle="Medicina" fastMotion />
    <HeroPreguntasFrecuentes />
    <main>
        <section class="content">
            <div class="title">
                <div></div><h5 class="light">Preguntas Frecuentes</h5>
            </div>
            <div class="questions">
                {faqItems.map(([question, answer]) => (
                    <div>
                        <h3>{question}</h3>
                        <p><Fragment set:html={answer} /></p>
                    </div>
                ))}
            </div>
        </section>
    </main>
    <WhatsAppWidget />
    <Footer />
</BaseLayout>

<style>
    main {
        background: var(--white);
        margin-top: 45vh;
    }

    .content {
        padding: 150px 20px 150px;
        max-width: 1280px;
        margin: auto;
    }

    .title {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .title h5 {
        font-size: var(--text-md);
        color: var(--primary);
        margin: 0;
    }

    .title div {
        width: 6px;
        height: 6px;
        background: var(--primary);
    }

    .questions {
        padding: 0 0 0 14px;
    }

    .questions div {
        margin: 20px 0;
    }

    .questions h3 {
        color: var(--primary);
        font-size: var(--text-base);
        font-weight: var(--light);
        margin: 0;
    }

    .questions p {
        margin: 0;
        color: var(--gray-500);
        font-size: var(--text-sm);
    }

    @media (max-width: 550px) {
        .questions {
            padding: 0;
        }
    }
</style>
