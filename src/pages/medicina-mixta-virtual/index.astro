---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LicenciaturaHero from "../../sections/LicenciaturaHero.astro";
import Medicina from "../../icons/medicina.astro";
import Footer from "../../sections/Footer.astro";
import { getCollection } from "astro:content";
import DesktopView from "../../sections/medicina/DesktopView.astro";
import MobileView from "../../sections/medicina/MobileView.astro";
import WhatsAppWidget from "../../components/WhatsAppWidget.astro";
import Nav2 from "../../sections/Nav2.astro";
import { absoluteUrl } from "../../config/site";
import { programSchema } from "../../utils/seo";

const licenciaturas = await getCollection('licenciaturas');

const medicinaData = licenciaturas.find(l => l.data.titulo === "Medicina General")

if (!medicinaData) {
  throw new Error("Medicina General data not found");
}
---
<BaseLayout
    title="Medicina General Mixta-Virtual | RVOE 1205/2020 | UAD"
    description="Estudia la Licenciatura en Medicina General en modalidad Mixta-Virtual en la UAD. Conoce el RVOE 1205/2020, plan de estudios, prácticas clínicas y requisitos."
    image={medicinaData.data.portada}
    breadcrumbs={[
        { name: "Inicio", path: "/" },
        { name: "Oferta Educativa", path: "/" },
        { name: "Medicina General", path: "/medicina-mixta-virtual/" },
    ]}
    schema={programSchema({
        url: absoluteUrl("/medicina-mixta-virtual/"),
        name: "Licenciatura en Medicina General Mixta-Virtual",
        description: "Programa de Licenciatura en Medicina General de la Universidad Autónoma de Durango, impartido en modalidad Mixta-Virtual.",
        image: absoluteUrl(medicinaData.data.portada),
        rvoe: medicinaData.data.rvoe,
        semesters: medicinaData.data.plan_estudios.length,
        credential: "Licenciatura en Medicina General",
    })}
>
    <!-- <Nav LicenciaturaTitle="Medicina" LicenciaturaSlug={"medicina-mixta-virtual"}/> -->
    <Nav2 LicenciaturaTitle="Medicina" LicenciaturaSlug={"medicina-mixta-virtual"}/>
    <LicenciaturaHero 
        image={medicinaData.data.portada}
        title={medicinaData.data.titulo}
        rvoe={medicinaData.data.rvoe} 
    >
        <Medicina width="102px" />
    </LicenciaturaHero>
    <main id="medicina">
        <div class="max-w">
            <DesktopView data={medicinaData.data} />
            <MobileView data={medicinaData.data} />
        </div>
        <WhatsAppWidget />
        <Footer />
    </main>
</BaseLayout>

<style>
    main {
        background: var(--gray-950);
        margin-top: 50vh;
    }

    .max-w {
        padding: 30px 20px;
        max-width: 1280px;
        margin: auto;
    }
</style>

<style is:global>
    .modal {
        display: none;
        position: fixed;
        flex-direction: column;
        justify-content: center;
        align-items: end;
        z-index: 250;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgb(0,0,0);
        background-color: rgba(0,0,0,0.9);
        opacity: 0;
        transition: opacity var(--motion-panel) ease;
    }

    .modal.show {
        display: flex;
        opacity: 1;
    }

    .modal-content {
        margin: 10px auto;
        display: block;
        width: 95%;
        max-width: 1080px;
        animation: modalContentShow var(--motion-panel) ease;
    }

    .close {
        color: #fff;
        font-size: 40px;
        font-weight: bold;
        transition: color var(--motion-fast) ease;
        cursor: pointer;
        margin: 0 3.5vw 0;
    }

    .close:hover,
    .close:focus {
        color: #bbb;
        text-decoration: none;
        cursor: pointer;
    }

    @media only screen and (max-width: 700px) {
        .modal-content {
            width: 98%;
        }
    }

    @keyframes modalContentShow {
        from {
            transform: scale(0.8);
            opacity: 0;
        }
        to {
            transform: scale(1);
            opacity: 1;
        }
    }
</style>

<script>
    type ViewMode = 'desktop' | 'mobile';

    let activeMode: ViewMode | null = null;
    let interactionController: AbortController | null = null;
    let pageCleanup: (() => void) | null = null;
    let resizeFrame: number | null = null;

    const prefersReducedMotion = (): boolean =>
        window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function initializeLargeView(signal: AbortSignal): void {
        const buttons: NodeListOf<HTMLElement> = document.querySelectorAll('.menu-btn');
        const sections: NodeListOf<HTMLElement> = document.querySelectorAll('.content-section > div');
        const contentContainer: HTMLElement | null = document.querySelector('.content-section');
        const reducedMotion = prefersReducedMotion();

        function animateHeight(element: HTMLElement, from: number, to: number): void {
            if (reducedMotion) {
                element.style.transition = 'none';
                element.style.height = `${to}px`;
                return;
            }

            element.style.height = `${from}px`;
            element.offsetHeight;
            element.style.transition = 'height var(--motion-panel) ease';
            element.style.height = `${to}px`;
        }

        let defaultSectionId = 'proposito-content';
        const hash = window.location.hash;
        const internalNavigation = sessionStorage.getItem('internalNavigation');

        if (hash) {
            switch (hash.toLowerCase()) {
                case '#plan_de_estudios':
                    defaultSectionId = 'plan-content';
                    break;
                case '#mapa_curricular':
                    defaultSectionId = 'perfil-content';
                    break;
            }
        } else if (internalNavigation === 'true') {
            const savedSectionId = sessionStorage.getItem('defaultSectionId');
            if (savedSectionId) {
                defaultSectionId = savedSectionId;
            }
        }

        const defaultSection: HTMLElement | null = document.getElementById(defaultSectionId);

        sections.forEach((section: HTMLElement) => {
            section.classList.add('hidden');
            section.classList.remove('fade-in');
        });
        buttons.forEach((button: HTMLElement) => button.classList.remove('selected'));

        if (defaultSection) {
            defaultSection.classList.remove('hidden');
            defaultSection.classList.add('fade-in');

            const defaultButton: HTMLElement | null = document.querySelector(`[data-target="${defaultSectionId}"]`);
            defaultButton?.classList.add('selected');
        }

        if (contentContainer && defaultSection) {
            contentContainer.style.height = `${defaultSection.scrollHeight}px`;
        }

        buttons.forEach((button: HTMLElement) => {
            button.addEventListener('click', function (this: HTMLElement) {
                buttons.forEach((btn: HTMLElement) => btn.classList.remove('selected'));
                this.classList.add('selected');

                const target = this.getAttribute('data-target');
                const targetSection = target ? document.getElementById(target) : null;

                if (target) {
                    sessionStorage.setItem('defaultSectionId', target);
                    sessionStorage.setItem('internalNavigation', 'true');
                }

                if (contentContainer && targetSection) {
                    const currentHeight = contentContainer.scrollHeight;

                    sections.forEach((section: HTMLElement) => {
                        section.classList.add('hidden');
                        section.classList.remove('fade-in');
                    });

                    targetSection.classList.remove('hidden');
                    targetSection.classList.add('fade-in');

                    requestAnimationFrame(() => {
                        animateHeight(contentContainer, currentHeight, targetSection.scrollHeight);
                    });
                }
            }, { signal });
        });
    }

    function setupCollapsibles(signal: AbortSignal): void {
        const collapses: HTMLElement[] = Array.from(document.querySelectorAll<HTMLElement>('.collapse'));

        collapses.forEach((collapse: HTMLElement) => {
            const button: HTMLElement | null = collapse.querySelector('.menu-btn-m');
            const content: HTMLElement | null = collapse.querySelector('.collapse-content');

            if (!button || !content) {
                return;
            }

            button.addEventListener('click', () => {
                const isOpen = collapse.classList.contains('open');

                collapses.forEach((otherCollapse: HTMLElement) => {
                    if (otherCollapse === collapse) {
                        return;
                    }

                    otherCollapse.classList.remove('open');
                    otherCollapse.querySelector<HTMLElement>('.menu-btn-m')?.classList.remove('selected');
                    const otherContent = otherCollapse.querySelector<HTMLElement>('.collapse-content');
                    if (otherContent) {
                        otherContent.style.height = '0px';
                    }
                });

                if (isOpen) {
                    collapse.classList.remove('open');
                    button.classList.remove('selected');
                    content.style.height = '0px';
                    return;
                }

                collapse.classList.add('open');
                button.classList.add('selected');
                requestAnimationFrame(() => {
                    content.style.height = `${content.scrollHeight}px`;
                });
            }, { signal });
        });
    }

    function checkWindowSize(): void {
        const largeView: HTMLElement | null = document.getElementById('desktop-view');
        const mobileView: HTMLElement | null = document.getElementById('mobile-view');

        if (!largeView || !mobileView) {
            return;
        }

        const nextMode: ViewMode = window.innerWidth <= 600 ? 'mobile' : 'desktop';
        largeView.style.display = nextMode === 'desktop' ? 'grid' : 'none';
        mobileView.style.display = nextMode === 'mobile' ? 'flex' : 'none';

        if (activeMode === nextMode && nextMode === 'mobile') {
            document.querySelectorAll<HTMLElement>('.collapse.open .collapse-content').forEach((content) => {
                content.style.height = `${content.scrollHeight}px`;
            });
            return;
        }

        interactionController?.abort();
        interactionController = new AbortController();
        activeMode = nextMode;

        if (nextMode === 'mobile') {
            setupCollapsibles(interactionController.signal);
        } else {
            initializeLargeView(interactionController.signal);
        }
    }

    function showModal(): () => void {
        const controller = new AbortController();
        const pendingTimers = new Set<number>();
        const pendingFrames = new Set<number>();
        const modals: HTMLDivElement[] = [];
        const reducedMotion = prefersReducedMotion();
        const motionPanel = Number.parseFloat(
            getComputedStyle(document.documentElement).getPropertyValue('--motion-panel'),
        );
        const closeDelay = reducedMotion || !Number.isFinite(motionPanel) ? (reducedMotion ? 0 : 500) : motionPanel;

        const clearPending = (): void => {
            pendingTimers.forEach((timer) => window.clearTimeout(timer));
            pendingTimers.clear();
            pendingFrames.forEach((frame) => window.cancelAnimationFrame(frame));
            pendingFrames.clear();
        };

        const schedule = (callback: () => void, delay: number): void => {
            const timer = window.setTimeout(() => {
                pendingTimers.delete(timer);
                callback();
            }, delay);
            pendingTimers.add(timer);
        };

        document.querySelectorAll<HTMLImageElement>('.mapa img').forEach((image) => {
            const modal = document.createElement('div');
            modal.className = 'modal';

            const closeButton = document.createElement('span');
            closeButton.className = 'close';
            closeButton.setAttribute('role', 'button');
            closeButton.setAttribute('aria-label', 'Cerrar imagen');
            closeButton.textContent = '×';

            const modalImage = document.createElement('img');
            modalImage.className = 'modal-content';
            modalImage.alt = image.alt;

            const caption = document.createElement('div');
            caption.className = 'caption';

            modal.append(closeButton, modalImage, caption);
            document.body.appendChild(modal);
            modals.push(modal);

            const close = (): void => {
                clearPending();
                modal.classList.remove('show');
                if (closeDelay === 0) {
                    modal.style.display = 'none';
                } else {
                    schedule(() => {
                        modal.style.display = 'none';
                    }, closeDelay);
                }
            };

            image.addEventListener('click', () => {
                clearPending();
                modals.forEach((otherModal) => {
                    if (otherModal !== modal) {
                        otherModal.classList.remove('show');
                        otherModal.style.display = 'none';
                    }
                });
                modalImage.src = image.currentSrc || image.src;
                caption.textContent = image.alt;
                modal.style.display = 'flex';
                if (reducedMotion) {
                    modal.classList.add('show');
                    return;
                }

                const frame = window.requestAnimationFrame(() => {
                    pendingFrames.delete(frame);
                    modal.classList.add('show');
                });
                pendingFrames.add(frame);
            }, { signal: controller.signal });

            closeButton.addEventListener('click', close, { signal: controller.signal });
            modal.addEventListener('click', (event: MouseEvent) => {
                if (event.target === modal) {
                    close();
                }
            }, { signal: controller.signal });
        });

        return () => {
            clearPending();
            controller.abort();
            modals.forEach((modal) => modal.remove());
        };
    }

    function initializePage(): void {
        pageCleanup?.();
        interactionController?.abort();
        activeMode = null;

        const modalCleanup = showModal();
        checkWindowSize();
        sessionStorage.setItem('internalNavigation', 'false');

        const cleanup = (): void => {
            if (resizeFrame !== null) {
                window.cancelAnimationFrame(resizeFrame);
                resizeFrame = null;
            }
            interactionController?.abort();
            interactionController = null;
            activeMode = null;
            modalCleanup();
            document.removeEventListener('astro:before-swap', cleanup);
        };

        document.addEventListener('astro:before-swap', cleanup, { once: true });
        pageCleanup = cleanup;
    }

    function handleResize(): void {
        if (resizeFrame !== null) {
            window.cancelAnimationFrame(resizeFrame);
        }
        resizeFrame = window.requestAnimationFrame(() => {
            resizeFrame = null;
            checkWindowSize();
        });
    }

    document.addEventListener('astro:page-load', initializePage);
    window.addEventListener('resize', handleResize, { passive: true });
</script>
