                class="img-container"
                data-aos={animationRight}
                data-aos-offset={animationOffset}
                data-aos-once={once}
            >
                <img
                    src="/images/hospital_virtual/HV_img1.jpg"
                    alt="Imagen 1"
                    loading="lazy"
                />
            </div>
            <div
                class="img-container"
                data-aos={animationLeft}
                data-aos-offset={animationOffset}
                data-aos-once={once}
            >
                <img
                    src="/images/hospital_virtual/HV_img2.jpg"
                    alt="Imagen 2"
                    loading="lazy"
                />
            </div>
            <div
                class="img-container"
                data-aos={animationRight}
                data-aos-offset={animationOffset}
                data-aos-once={once}
            >
                <img
                    src="/images/hospital_virtual/HV_img3.jpg"
                    alt="Imagen 3"
                    loading="lazy"
                />
            </div>
            <div
                class="img-container"
                data-aos={animationLeft}
                data-aos-offset={animationOffset}
                data-aos-once={once}
            >
                <img
                    src="/images/hospital_virtual/HV_img4.jpg"
                    alt="Imagen 4"
                    loading="lazy"
                />
            </div>
            <div
                class="img-container"
                data-aos={animationRight}
                data-aos-offset={animationOffset}
                data-aos-once={once}
            >
                <img
                    src="/images/hospital_virtual/HV_img5.jpg"
                    alt="Imagen 5"
                    loading="lazy"
                />
            </div>
            <div
                class="img-container"
                data-aos={animationLeft}
                data-aos-offset={animationOffset}
                data-aos-once={once}
            >
                <img
                    src="/images/hospital_virtual/HV_img6.jpg"
                    alt="Imagen 6"
                    loading="lazy"
                />
            </div>
            <div
                class="img-container"
                data-aos={animationRight}
                data-aos-offset={animationOffset}
                data-aos-once={once}
            >
                <img
                    src="/images/hospital_virtual/HV_img7.jpg"
                    alt="Imagen 7"
                    loading="lazy"
                />
            </div>
            <div
                class="img-container"
                data-aos={animationLeft}
                data-aos-offset={animationOffset}
                data-aos-once={once}
            >
                <img
                    src="/images/hospital_virtual/HV_img8.jpg"
                    alt="Imagen 8"
                    loading="lazy"
                />
            </div>
            <div
                class="img-container"
                data-aos={animationRight}
                data-aos-offset={animationOffset}
                data-aos-once={once}
            >
                <img
                    src="/images/hospital_virtual/HV_img9.jpg"
                    alt="Imagen 9"
                    loading="lazy"
                />
            </div>
            <div
                class="img-container"
                data-aos={animationLeft}
                data-aos-offset={animationOffset}
                data-aos-once={once}
            >
                <img
                    src="/images/hospital_virtual/HV_img10.jpg"
                    alt="Imagen 10"
                    loading="lazy"
                />
            </div>
        </div>
    </div>
</section>
<div id="modal" class="modal">
    <div class="modal-content">
        <span class="close" id="modal-close">&times;</span>
        <img id="modal-img" />
        <div class="nav-btns">
            <span class="prev" id="modal-prev">&#10094;</span>
            <span class="next" id="modal-next">&#10095;</span>
        </div>
    </div>
</div>

<style>
    .hospital-section {
        margin-top: -50px;
        padding: 70px 20px;
        background: var(--black);
        overflow: hidden;
    }

    .content {
        display: flex;
        flex-direction: column;
        align-items: center;
        max-width: 1080px;
        margin: auto;
    }

    .gallery {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        margin: 70px 0 120px;
        gap: 15px;
        width: 100%;
    }

    .img-container {
        position: relative;
        width: 100%;
        padding-bottom: 55.36%;
        overflow: hidden;
    }

    .img-container img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: 50% 10%;
        transition: object-position var(--motion-base) ease-in-out;
        cursor: pointer;
    }

    .img-container:hover img {
        object-position: 50% 40%;
    }

    @media (max-width: 768px) {
        .gallery {
            grid-template-columns: 1fr;
        }

        #modal-img {
            width: 98% !important;
        }

        .close {
            font-size: 8vw !important;
            margin: 0 0 8px !important;
        }

        .prev,
        .next {
            font-size: 6vw !important;
        }
    }

    .modal {
        display: none;
        position: fixed;
        z-index: 99;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0, 0, 0, 0.9);
        justify-content: center;
        align-items: center;
        opacity: 0;
        transition: opacity var(--motion-base) ease-in-out;
    }

    .modal.show {
        display: flex;
        opacity: 1;
    }

    .modal-content {
        position: absolute;
        display: flex;
        flex-direction: column;
        align-items: center;
        top: 50%;
        right: 50%;
        transform: translateY(-50%) translateX(50%);
        width: 98%;
        max-width: 1550px;
    }

    .nav-btns {
        margin: 20px 0 0;
        display: flex;
        gap: 40px;
    }

    #modal-img {
        width: 90%;
        max-width: 1440px;
        opacity: 0;
        transition: opacity var(--motion-base) ease-in-out;
    }

    #modal-img.show {
        opacity: 1;
    }

    #modal-img.transition-out {
        opacity: 0;
    }

    .close {
        color: #fff;
        font-size: 40px;
        font-weight: bold;
        transition: color var(--motion-fast) ease;
        align-self: flex-end;
        margin: 0 40px 10px 0;
    }

    .close:hover,
    .close:focus {
        color: #bbb;
        text-decoration: none;
        cursor: pointer;
    }

    .prev,
    .next {
        cursor: pointer;
        color: #fff;
        font-size: 30px;
        font-weight: bold;
        transition: color var(--motion-fast) ease;
        user-select: none;
        align-self: center;
    }

    .prev:hover,
    .next:hover {
        color: #bbb;
    }
</style>

<script>
    let cleanupHospitalGallery: (() => void) | null = null;

    document.addEventListener("astro:page-load", function () {
        cleanupHospitalGallery?.();

        const modal = document.getElementById("modal") as HTMLElement | null;
        const modalImg = document.getElementById("modal-img") as HTMLImageElement | null;
        const closeBtn = document.getElementById("modal-close") as HTMLElement | null;
        const prevBtn = document.getElementById("modal-prev") as HTMLElement | null;
        const nextBtn = document.getElementById("modal-next") as HTMLElement | null;

        if (!modal || !modalImg || !closeBtn || !prevBtn || !nextBtn) {
            cleanupHospitalGallery = null;
            return;
        }

        const images = document.querySelectorAll(
            ".img-container img",
        ) as NodeListOf<HTMLImageElement>;
        if (images.length === 0) {
            cleanupHospitalGallery = null;
            return;
        }

        const controller = new AbortController();
        const pendingTimers = new Set<number>();
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const motionBase = Number.parseFloat(
            getComputedStyle(document.documentElement).getPropertyValue("--motion-base"),
        );
        const transitionDelay = reducedMotion || !Number.isFinite(motionBase)
            ? (reducedMotion ? 0 : 300)
            : motionBase;
        let currentIndex = 0;

        const clearPendingTimers = (): void => {
            pendingTimers.forEach(timerId => window.clearTimeout(timerId));
            pendingTimers.clear();
        };

        const schedule = (callback: () => void, delay: number): void => {
            const timerId = window.setTimeout(() => {
                pendingTimers.delete(timerId);
                callback();
            }, delay);
            pendingTimers.add(timerId);
        };

        const openModal = (): void => {
            clearPendingTimers();
            modal.style.display = "flex";
            modalImg.src = images[currentIndex]?.currentSrc || images[currentIndex]?.src || "";

            if (reducedMotion) {
                modal.classList.add("show");
                modalImg.classList.add("show");
                return;
            }

            window.requestAnimationFrame(() => {
                modal.classList.add("show");
                modalImg.classList.add("show");
            });
        };

        const closeModal = (): void => {
            clearPendingTimers();
            modalImg.classList.remove("show");
            modal.classList.remove("show");
            schedule(() => {
                modal.style.display = "none";
            }, transitionDelay);
        };

        const changeImage = (newIndex: number): void => {
            clearPendingTimers();
            currentIndex = newIndex;
            modalImg.classList.remove("show");
            modalImg.classList.add("transition-out");
            schedule(() => {
                modalImg.src = images[currentIndex]?.currentSrc || images[currentIndex]?.src || "";
                modalImg.classList.remove("transition-out");
                modalImg.classList.add("show");
            }, transitionDelay);
        };

        const showPrev = (): void => {
            const newIndex = currentIndex > 0 ? currentIndex - 1 : images.length - 1;
            changeImage(newIndex);
        };

        const showNext = (): void => {
            const newIndex = currentIndex < images.length - 1 ? currentIndex + 1 : 0;
            changeImage(newIndex);
        };

        const handleClickOutside = (event: MouseEvent): void => {
            const target = event.target as HTMLElement | null;
            const isInImage = target === modalImg;
            const isInNavButtons = target?.closest(".nav-btns") !== null;

            if (!isInImage && !isInNavButtons) {
                closeModal();
            }
        };

        modal.addEventListener("click", handleClickOutside, { signal: controller.signal });
        images.forEach((img, index) => {
            img.addEventListener("click", () => {
                currentIndex = index;
                openModal();
            }, { signal: controller.signal });
        });
        closeBtn.addEventListener("click", closeModal, { signal: controller.signal });
        prevBtn.addEventListener("click", showPrev, { signal: controller.signal });
        nextBtn.addEventListener("click", showNext, { signal: controller.signal });

        const cleanup = (): void => {
            clearPendingTimers();
            controller.abort();
            modal.classList.remove("show");
            modalImg.classList.remove("show", "transition-out");
            modal.style.display = "none";
            document.removeEventListener("astro:before-swap", cleanup);
        };

        document.addEventListener("astro:before-swap", cleanup, { once: true });
        cleanupHospitalGallery = cleanup;
    });
</script>
