---
import BienvenidosMedicina from "../icons/bienvenidos-medicina.astro"
---
<section class="preguntas-hero" id="hero">
    <div class="img-container">
        <img src="/images/hospital_virtual/HV_img2.jpg" alt="">
        <img src="/images/hospital_virtual/HV_img4.jpg" alt="">
        <img src="/images/hospital_virtual/HV_img6.jpg" alt="">
    </div>
    <div class="logo">
        <BienvenidosMedicina />
    </div>
</section>

<style>
    .preguntas-hero {
        z-index: -5;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        height: 45vh;
        overflow: hidden;
        position: fixed;
        top: 0;
        right: 0;
    }

    .img-container {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
    }

    .img-container img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        position: absolute;
        top: 0;
        left: 0;
        opacity: 0;
        transition: opacity var(--motion-hero) ease-in-out;
    }

    .img-container img.active {
        opacity: 1;
    }

    .img-container::after {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.30);
    }

    .logo {
        z-index: 0;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;

    }
</style>

<script>
    let cleanupCarousel: (() => void) | null = null;

    document.addEventListener('astro:page-load', function() {
        cleanupCarousel?.();

        const images: NodeListOf<HTMLImageElement> = document.querySelectorAll('.img-container img');
        if (images.length === 0) {
            cleanupCarousel = null;
            return;
        }

        let currentImageIndex: number = 0;
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        function showNextImage(): void {
            images[currentImageIndex].classList.remove('active');
            currentImageIndex = (currentImageIndex + 1) % images.length;
            images[currentImageIndex].classList.add('active');
        }

        images[currentImageIndex].classList.add('active');

        if (reducedMotion) {
            cleanupCarousel = null;
            return;
        }

        const intervalId: number = window.setInterval(showNextImage, 3700);

        const cleanup = (): void => {
            window.clearInterval(intervalId);
            document.removeEventListener('astro:before-swap', cleanup);
        };

        document.addEventListener('astro:before-swap', cleanup, { once: true });
        cleanupCarousel = cleanup;
    });
</script>
